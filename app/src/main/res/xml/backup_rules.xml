<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: back up the projects and the settings. -->
<full-backup-content>
    <include domain="file" path="projects/" />
    <include domain="sharedpref" path="." />
    <!-- the sign-in of the community section stays on this phone -->
    <exclude domain="sharedpref" path="cloud.xml" />
</full-backup-content>
