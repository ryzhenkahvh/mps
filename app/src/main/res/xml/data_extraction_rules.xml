<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: projects and settings are included in cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="projects/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="projects/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
